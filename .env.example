# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ─── WhatsApp owners ──────────────────────────────────────────────────────────
# Números separados por coma en formato 57XXXXXXXXXX (sin + ni espacios)
OWNER_NOTIFY_PHONES=573204665094,573223272342

# ─── Rutas de almacenamiento persistente (Render / producción) ────────────────
# En Render: montar Persistent Disk en /var/data
# Dejar vacío en local (usa ./data y ./auth automáticamente)
DATA_DIR=/var/data/data
AUTH_DIR=/var/data/auth

# ─── Shopify ──────────────────────────────────────────────────────────────────
# Secret del webhook: Shopify Admin → Settings → Notifications → Webhooks
# (texto "Tus webhooks se firmarán con ...")
SHOPIFY_WEBHOOK_SECRET=

# Delay en segundos antes de enviar la confirmación al cliente.
# Estrategia anti-bloqueo: Releasit pide al cliente que escriba primero a
# WhatsApp. Si el cliente escribe dentro de este delay, la confirmación se
# envía inmediatamente (handler adelanta el outbox). Si no escribe, se
# envía igual al cumplirse el delay. Default: 180 (3 minutos).
SHOPIFY_CONFIRMATION_DELAY_SECONDS=180

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=production
